# Copy this file to .env and fill in your own values. Never commit .env.

# API key for the LLM provider (required).
# Google Gemini (free tier): https://aistudio.google.com/apikey
LLM_API_KEY=

# Any OpenAI-compatible chat-completions endpoint works.
# Gemini (default):  https://generativelanguage.googleapis.com/v1beta/openai/
# OpenAI:            https://api.openai.com/v1
# Groq:              https://api.groq.com/openai/v1
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/

# Model name for the chosen provider (must support tool/function calling).
LLM_MODEL=gemini-3.5-flash

# Optional: minimum seconds between LLM requests (helps stay under free-tier
# requests-per-minute limits; 0 disables throttling).
LLM_MIN_INTERVAL=4

# Optional: comma-separated models to switch to if the main model's quota is
# exhausted or it is unavailable (useful on free tiers).
LLM_FALLBACK_MODELS=gemini-3.6-flash,gemini-3-flash-preview,gemini-3.5-flash-lite
